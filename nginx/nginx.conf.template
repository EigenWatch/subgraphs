events {
    worker_connections 1024;
}

http {
    # Rate limiting zone
    limit_req_zone $binary_remote_addr zone=graphql:10m rate=100r/s;

    server {
        listen 80;

        # Health check endpoint (no auth required)
        location /health {
            return 200 'ok';
            add_header Content-Type text/plain;
        }

        # GraphQL endpoint with API key validation
        location /subgraphs/ {
            # Check for API key in header
            if ($http_x_api_key != "${GRAPHQL_API_KEY}") {
                return 401 '{"error": "Unauthorized - Invalid or missing API key"}';
            }

            # Rate limiting
            limit_req zone=graphql burst=50 nodelay;

            # Proxy to graph-node
            proxy_pass http://graph-node:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # CORS headers
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, X-API-Key" always;

            if ($request_method = OPTIONS) {
                return 204;
            }
        }

        # Indexing status API (optional: add auth here too)
        location /graphql {
            if ($http_x_api_key != "${GRAPHQL_API_KEY}") {
                return 401 '{"error": "Unauthorized - Invalid or missing API key"}';
            }

            proxy_pass http://graph-node:8030;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # Graph Node Metrics (protected)
        location /metrics {
            if ($http_x_api_key != "${GRAPHQL_API_KEY}") {
                return 401 '{"error": "Unauthorized - Invalid or missing API key"}';
            }

            proxy_pass http://graph-node:8040;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # Prometheus API (protected - for external Grafana)
        location /prometheus/ {
            if ($http_x_api_key != "${GRAPHQL_API_KEY}") {
                return 401 '{"error": "Unauthorized - Invalid or missing API key"}';
            }

            # Strip /prometheus prefix before proxying
            rewrite ^/prometheus/(.*) /$1 break;
            proxy_pass http://prometheus:9090;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # RPC Proxy Metrics (protected - for external Grafana)
        location = /rpc-metrics {
            if ($http_x_api_key != "${GRAPHQL_API_KEY}") {
                return 401 '{"error": "Unauthorized - Invalid or missing API key"}';
            }

            rewrite ^/rpc-metrics$ /metrics break;
            proxy_pass http://rpc-proxy:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # Subgraph Deployment API (key in URL path for graph-cli compatibility)
        # Usage: https://subgraph.eigenwatch.xyz/deploy/<DEPLOY_KEY>/
        location ~ ^/deploy/([^/]+) {
            set $deploy_key $1;
            
            if ($deploy_key != "${GRAPHQL_API_KEY}") {
                return 401 '{"error": "Unauthorized - Invalid deploy key"}';
            }

            # Rewrite path to strip deploy key prefix
            rewrite ^/deploy/[^/]+/?(.*)$ /$1 break;

            # Proxy to Graph Node JSON-RPC admin API
            proxy_pass http://graph-node:8020;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Content-Type application/json;
            
            # Allow large subgraph uploads
            client_max_body_size 50M;
        }

        # IPFS API (key in URL path for graph-cli compatibility)
        # Usage: https://subgraph.eigenwatch.xyz/ipfs/<DEPLOY_KEY>/api/v0/add
        location ~ ^/ipfs/([^/]+)(/.*)$ {
            set $deploy_key $1;
            set $ipfs_path $2;
            
            if ($deploy_key != "${GRAPHQL_API_KEY}") {
                return 401 '{"error": "Unauthorized - Invalid deploy key"}';
            }

            # Rewrite to the IPFS path
            rewrite ^/ipfs/[^/]+(/.*)$ $1 break;

            proxy_pass http://ipfs:5001;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            
            # Allow large file uploads
            client_max_body_size 50M;
        }
    }
}
