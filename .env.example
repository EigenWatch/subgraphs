# RPC Proxy (Primary)
RPC_GATEWAY_URL=https://gateway.thebuidl.xyz/query
RPC_API_KEY=your_api_key_here

# Alchemy RPC Providers (used for non-eth_getLogs calls during backfill)
ALCHEMY_RPC_URL=
ALCHEMY_RPC_URL_2=
ALCHEMY_RPC_URL_3=

# Infura RPC Providers (used for eth_getLogs calls during backfill - supports 5000 block ranges on free tier)
INFURA_RPC_URL=
INFURA_RPC_URL_2=
INFURA_RPC_URL_3=

# Backfill threshold: blocks behind > threshold = backfill mode
# Backfill mode routes eth_getLogs to Infura, other calls to Alchemy, excludes thebuidl
# Normal mode (caught up) uses thebuidl as primary with all others as fallbacks
BACKFILL_THRESHOLD=1000

# PostgreSQL (external instance)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=graph-node
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=graph_node

# GraphQL API Key (clients must pass this in X-API-Key header)
GRAPHQL_API_KEY=your_secure_api_key_here
