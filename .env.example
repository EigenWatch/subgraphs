# RPC Proxy (Primary)
RPC_GATEWAY_URL=https://gateway.thebuidl.xyz/query
RPC_API_KEY=your_api_key_here

# Fallback RPC Providers (optional - used if primary fails, or for load balancing during backfill)
ALCHEMY_RPC_URL=
# ALCHEMY_RPC_URL_2=
INFURA_RPC_URL=

# Load Balancing: blocks behind threshold to switch from fallback mode to load-balance mode
# When blocks behind > threshold, requests are distributed across all providers
# When blocks behind <= threshold, only primary is used with others as fallbacks
BACKFILL_THRESHOLD=1000

# PostgreSQL (external instance)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=graph-node
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=graph_node

# GraphQL API Key (clients must pass this in X-API-Key header)
GRAPHQL_API_KEY=your_secure_api_key_here
