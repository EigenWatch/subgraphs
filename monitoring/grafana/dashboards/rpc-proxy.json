    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "📡 RPC Proxy",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "1": { "text": "thebuidl" } }, "type": "value" },
            { "options": { "2": { "text": "alchemy" } }, "type": "value" },
            { "options": { "3": { "text": "infura" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "rpc_active_provider",
          "refId": "A"
        }
      ],
      "title": "Active Provider",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "sum(increase(rpc_requests_total[1h]))",
          "refId": "A"
        }
      ],
      "title": "Requests (1h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
